---
import { config } from "@parseConfig"

const year = new Date().getFullYear()
---

<footer
  class="mt-16 flex w-full items-baseline justify-end gap-x-4 pt-8 text-xs text-muted-foreground sm:text-sm"
>
  <p>
    &copy; {year}
    <span class="font-medium text-foreground/80">{config.site.author}</span>
  </p>


</footer>
