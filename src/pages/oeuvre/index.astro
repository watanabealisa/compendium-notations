---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Prose from "@components/common/Prose.astro";
---

<BaseLayout title="Oeuvre - Compendium Notations">
  <Prose>
    <h1>Oeuvre</h1>

    <div class="not-prose">
      <article class="track">
        <h4>sequence diagram dots （シークエンスダイアグラムドッツ）</h4>
        <div class="meta">2016 — CeVIO、VOCALOID、EDM、Funkot、POP</div>
        
        <!-- YouTube埋め込み枠 -->
        <div class="video-wrapper">
          <iframe 
            src="https://www.youtube.com/embed/mEVTuKA_f2s" 
            title="sequence diagram dots" 
            frameborder="0" 
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
            allowfullscreen>
          </iframe>
        </div>

        <p class="description">
          ボーカロイド（CeVIO）特有の透明感と機械的な質感を活かした、リズミカルで疾走感のあるエレクトロニック・ポップチューン。緻密に構築されたトラックとシャープなサウンドデザインが織りなすスタイリッシュな世界観が特徴。
        </p>
        <div class="external-links">
          <span style="color: #18181b;"></span> 
          <a href="https://n0.com/a/zhxpcvfnf1ri" target="_blank" rel="noopener noreferrer">Streaming ↗</a>
          <a href="#">Spotify ↗</a>
          <a href="#">Apple Music ↗</a>
        </div>
      </article>

      <article class="track">
        <h3>Nocturne for Rhodes &amp; Sampler</h3>
        <div class="meta">2026 — Electric Piano, Vocal Chop</div>
        
        <div class="player-box">
          <div style="font-size: 0.875rem; color: #71717a;">Spotify / SoundCloud Player</div>
        </div>

        <p class="description">
          ローズピアノのコード進行を軸に、自身のソプラノの断片をサンプリングして構築したインストゥルメンタル小品。
        </p>
      </article>
    </div>
  </Prose>
</BaseLayout>

<style>
  .track {
    margin-bottom: 4.5rem;
    padding-bottom: 3.5rem;
    border-bottom: 1px solid #e4e4e7;
  }
  .track:last-child {
    border-bottom: none;
  }
  .track h3 {
    font-size: 1.15rem;
    font-weight: 600;
    margin: 0 0 0.25rem 0;
    letter-spacing: -0.01em;
  }
  .meta {
    font-size: 0.875rem;
    color: #71717a;
    margin-bottom: 1.5rem;
    font-variant-numeric: tabular-nums;
  }
  /* YouTubeを16:9で綺麗に収めるレスポンシブ枠 */
  .video-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: #f4f4f5;
    border: 1px solid #e4e4e7;
    border-radius: 6px;
    overflow: hidden;
    margin-bottom: 1.5rem;
  }
  .video-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }
  .player-box {
    width: 100%;
    height: 120px;
    background-color: #f4f4f5;
    border: 1px solid #e4e4e7;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
  }
  .description {
    font-size: 0.95rem;
    line-height: 1.7;
    margin: 0 0 1.25rem 0;
  }
  .external-links {
    font-size: 0.85rem;
  }
  .external-links a {
    color: #71717a;
    text-decoration: none;
    margin-right: 1rem;
  }
  .external-links a:hover {
    color: #18181b;
    text-decoration: underline;
  }
</style>
