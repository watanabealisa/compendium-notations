
---
import BaseLayout from "@layouts/BaseLayout.astro"
import Prose from "@components/common/Prose.astro"
---

<BaseLayout title="Oeuvre">
  <Prose>
    <h1>Works</h1>

    <article class="track">
      <h2>Aria in Concrete</h2>
      <div class="meta">2026 — Soprano, Jazz Piano, Hip-Hop Beat</div>

      <div class="player-box">
        <div class="play-icon">▶</div>
        <div>YouTube / SoundCloud Player</div>
      </div>

      <p class="description">
        声楽のコロラトゥーラ・アリアの技巧と、乾いたヒップホップのビート、ジャズピアノのループを交差させた実験作。クラシックの発声法を現代のトラックメイクの文脈に再配置しています。
      </p>

      <div class="external-links">
        <a href="#">YouTube ↗</a>
        <a href="#">Spotify ↗</a>
        <a href="#">Apple Music ↗</a>
      </div>
    </article>

    <article class="track">
      <h2>Nocturne for Rhodes &amp; Sampler</h2>
      <div class="meta">2026 — Electric Piano, Vocal Chop</div>

      <div class="player-box audio">
        Spotify / SoundCloud Audio Player
      </div>

      <p class="description">
        ローズピアノのコード進行を軸に、自身のソプラノの断片をサンプリングして構築したインストゥルメンタル小品。
      </p>
    </article>
  </Prose>
</BaseLayout>

<style>
  .track {
    margin-top: 3rem;
    margin-bottom: 4rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--border);
  }

  .track h2 {
    font-size: 1.15rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .meta {
    font-size: 0.875rem;
    color: var(--muted);
    margin-bottom: 1.5rem;
  }

  .player-box {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 6px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .player-box.audio {
    aspect-ratio: auto;
    height: 152px;
  }

  .play-icon {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  .description {
    font-size: 0.95rem;
    margin-bottom: 1.25rem;
  }

  .external-links {
    font-size: 0.85rem;
  }

  .external-links a {
    color: var(--muted);
    text-decoration: none;
    margin-right: 1rem;
  }

  .external-links a:hover {
    text-decoration: underline;
  }
</style>
