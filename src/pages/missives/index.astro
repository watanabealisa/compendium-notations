---
import BaseLayout from "@layouts/BaseLayout.astro"
import Prose from "@components/common/Prose.astro"
import { getMissives } from "@utils/getContent"

const missiveEntries = await getMissives()
---

<BaseLayout title="Missives">
  <Prose>
    <h1>Missives</h1>
    <div class="not-prose mt-8 flex flex-col gap-y-8">
      {
        missiveEntries.map((missiveEntry) => {
          const articleDate = missiveEntry.data.date

          return (
          <a
  href={`/${missiveEntry.collection}/${missiveEntry.id}`}
  class="missive-card group -m-4 flex flex-col gap-y-1 rounded-sm bg-card/0 p-4 transition-colors duration-200 ease-out hover:bg-card/75"
>
  <h2 class="font-medium text-foreground transition-colors duration-200 ease-out">
    {missiveEntry.data.title}
  </h2>
              {missiveEntry.data.description && (
                <p class="leading-normal text-muted-foreground">
                  {missiveEntry.data.description}
                </p>
              )}
            {articleDate && (
  <time class="text-sm text-muted-foreground no-underline">
    {articleDate}
  </time>
)}
            </a>
          )
        })
      }
    </div> 
  </Prose>
</BaseLayout>
<style>
  .missive-card,
  .missive-card:hover {
    text-decoration: none !important;
  }
</style>
