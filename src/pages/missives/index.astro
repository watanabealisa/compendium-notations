---
import BaseLayout from "@layouts/BaseLayout.astro"
import Prose from "@components/common/Prose.astro"
import MissivesCard from "@components/section/missives/MissivesCard.astro"
import { getMissives } from "@utils/getContent"

const {
  title = "Missives",
  description = "A collection of missives on things worth exploring.",
} = Astro.props

const missiveEntries = await getMissives()
---

<BaseLayout title={title} description={description}>
  <Prose>
    <h1>Missives</h1>
    <p>{description}</p>
    <div class="not-prose mt-8 flex flex-col gap-y-8">
      {
        missiveEntries.map((entry) => (
          <MissivesCard missivesEntry={entry} />
        ))
      }
    </div>
  </Prose>
</BaseLayout>
