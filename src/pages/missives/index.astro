---
import BaseLayout from "@layouts/BaseLayout.astro"
import Prose from "@components/common/Prose.astro"
import { getMissives } from "@utils/getContent"

const {
  title = "Missives",
  description = "A collection of missives on things worth exploring.",
} = Astro.props

const missiveEntries = await getMissives()
---

<BaseLayout title={title} description={description}>
  <Prose>
    <h1>Missives</h1>
    <p>{description}</p>
    <div class="not-prose mt-8 flex flex-col gap-y-6">
      {
        missiveEntries.map((missiveEntry) => {
          const articleDate = missiveEntry.data.date

          return (
            <a
              href={`/${missiveEntry.collection}/${missiveEntry.id}`}
              class="group -m-4 flex flex-col gap-y-2 rounded-sm bg-card/0 p-4 transition-colors duration-200 ease-out hover:bg-card/75"
            >
              <h2 class="font-medium text-foreground underline decoration-muted-foreground/50 underline-offset-2 transition-colors duration-200 ease-out group-hover:decoration-muted-foreground">
                {missiveEntry.data.title}
              </h2>
              {missiveEntry.data.description && (
                <p class="text-sm leading-normal text-muted-foreground">
                  {missiveEntry.data.description}
                </p>
              )}
              {articleDate && (
                <span class="text-xs text-muted-foreground">
                  {articleDate}
                </span>
              )}
            </a>
          )
        })
      }
    </div>
  </Prose>
</BaseLayout>
