---
import { type CollectionEntry, render } from "astro:content"

import MissivesPage from "@layouts/pages/MissivesPage.astro"
import { getMissives } from "@utils/getContent"

export async function getStaticPaths() {
  const missivesEntries = getMissives()

  return (await missivesEntries).map((missivesEntry) => ({
    params: { id: missivesEntry.id },
    props: { missivesEntry },
  }))
}

interface Props {
  missivesEntry: CollectionEntry<"missives">
}

const { missivesEntry } = Astro.props
const { Content, remarkPluginFrontmatter } = await render(missivesEntry)
---

<MissivesPage
  frontmatter={missivesEntry}
  readingTime={remarkPluginFrontmatter.minutesRead}
>
  <Content />
</MissivesPage>
