---
import { type CollectionEntry, render } from "astro:content"

import BaseLayout from "@layouts/BaseLayout.astro"
import Prose from "@components/common/Prose.astro"
import { getMissives } from "@utils/getContent"

export async function getStaticPaths() {
  const missivesEntries = await getMissives()

  return missivesEntries.map((missivesEntry) => ({
    params: { id: missivesEntry.id },
    props: { missivesEntry },
  }))
}

interface Props {
  missivesEntry: CollectionEntry<"missives">
}

const { missivesEntry } = Astro.props
const { Content } = await render(missivesEntry)

const { title, description, date } = missivesEntry.data
---

<BaseLayout title={title} description={description}>
  <Prose>
    <header class="not-prose mb-8">
      <h1 class="text-2xl font-semibold tracking-tight text-foreground">
        {title}
      </h1>
      {date && (
        <time class="mt-1 block text-sm text-muted-foreground">
          {date}
        </time>
      )}
    </header>
    <Content />
  </Prose>
</BaseLayout>
