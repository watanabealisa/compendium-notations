---
import BaseLayout from "@layouts/BaseLayout.astro"
import Prose from "@components/common/Prose.astro"
import MissiveCard from "@components/section/missives/MissiveCard.astro"
import { getMissives } from "@utils/getContent"

const {
  title = "Missives",
  description = "A collection of missives on things worth exploring.",
} = Astro.props

const missiveEntries = await getMissives()
---

<BaseLayout title={title} description={description}>
  <Prose>
    <h1>Missives</h1>
    <div class="not-prose flex flex-col gap-y-8">
      {
        missiveEntries.map((missiveEntry) => (
          <MissiveCard missiveEntry={missiveEntry} />
        ))
      }
    </div>
  </Prose>
</BaseLayout>
